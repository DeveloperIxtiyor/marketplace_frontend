"use client";
import React, { useState, useEffect } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";

type Kategoriya = {
  id: number;
  nomi: string;
  tavsif?: string;
  slug?: string;
  faol?: boolean;
};

export default function AdminKategoriyalarSahifa() {
  const [royxat, setRoyxat] = useState<Kategoriya[]>([]);
  const [yuklanmoqda, setYuklanmoqda] = useState(true);
  const [xato, setXato] = useState<string | null>(null);
  const [nomi, setNomi] = useState("");
  const [tavsif, setTavsif] = useState("");

  async function yukla() {
    try {
      const res = await fetch("/api/kategoriyalar");
      if (!res.ok) throw new Error(`Server xatosi: ${res.status}`);
      setRoyxat(await res.json());
      setXato(null);
    } catch (err) {
      setXato(err instanceof Error ? err.message : "Noma'lum xato");
    } finally {
      setYuklanmoqda(false);
    }
  }

  useEffect(() => {
    yukla();
  }, []);

  async function qosh(e: React.SyntheticEvent) {
    e.preventDefault();
    if (!nomi.trim()) return;
    const res = await fetch("/api/kategoriyalar", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ nomi, tavsif }),
    });
    if (!res.ok) {
      setXato("Qo'shib bo'lmadi");
      return;
    }
    setNomi("");
    setTavsif("");
    await yukla();
  }

  async function ochir(id: number) {
    if (!confirm("Kategoriya o'chirilsinmi?")) return;
    const res = await fetch(`/api/kategoriyalar/${id}`, { method: "DELETE" });
    if (!res.ok) {
      setXato("O'chirib bo'lmadi");
      return;
    }
    await yukla();
  }

  if (yuklanmoqda) return <div className="p-6 text-center text-white">Yuklanmoqda...</div>;

  return (
    <main className="p-6 text-white">
      <h1 className="text-2xl font-bold mb-4">Admin Kategoriyalar</h1>

      {xato && <p className="mb-4 text-red-400 text-sm">Xatolik: {xato}</p>}

      <form onSubmit={qosh} className="mb-6 grid gap-2 text-black max-w-md">
        <input
          value={nomi}
          onChange={(e) => setNomi(e.target.value)}
          placeholder="Kategoriya nomi"
          className="rounded px-3 py-2"
        />
        <input
          value={tavsif}
          onChange={(e) => setTavsif(e.target.value)}
          placeholder="Tavsif (ixtiyoriy)"
          className="rounded px-3 py-2"
        />
        <button type="submit" className="rounded bg-blue-600 text-white px-3 py-2 hover:bg-blue-700">
          Qo'shish
        </button>
      </form>

      <div className="grid gap-3 text-black">
        {royxat.length > 0 ? (
          royxat.map((k) => (
            <Card key={k.id} className={k.faol === false ? "opacity-60" : ""}>
              <CardHeader>
                <CardTitle className="text-lg font-semibold">
                  {k.nomi || "Nomsiz kategoriya"}
                </CardTitle>
              </CardHeader>
              <CardContent>
                <p className="text-sm text-gray-600">{k.tavsif || "Tavsif mavjud emas."}</p>
                <p className="text-xs text-gray-400 mt-2">
                  ID: {k.id} | Slug: {k.slug || "yo'q"}
                </p>
                <button
                  onClick={() => ochir(k.id)}
                  className="mt-3 rounded bg-red-600 text-white text-sm px-3 py-1 hover:bg-red-700"
                >
                  O'chirish
                </button>
              </CardContent>
            </Card>
          ))
        ) : (
          <p className="text-gray-400 text-sm p-4">Kategoriyalar ro'yxati bo'sh.</p>
        )}
      </div>
    </main>
  );
}